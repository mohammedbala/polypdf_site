{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.polypdf.com/schemas/screenshot-evidence.schema.json",
  "title": "PolyPDF website screenshot publication evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "records",
    "ogComposites"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/screenshotRecord"
      }
    },
    "ogComposites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ogComposite"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "pngBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "width",
        "height"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "outputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "width",
        "height",
        "derivedFrom",
        "transform"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "derivedFrom": {
          "$ref": "#/$defs/repoPath"
        },
        "transform": {
          "enum": [
            "byte-identical",
            "exact-50-percent"
          ]
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseCommit",
        "workingTreeProductDiffSha256"
      ],
      "properties": {
        "baseCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "workingTreeProductDiffSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme",
        "nativeMaximized",
        "viewportEmulation",
        "styleToolbarStateValidated",
        "pageOnlyCrop"
      ],
      "properties": {
        "theme": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "nativeMaximized": {
          "const": true
        },
        "viewportEmulation": {
          "const": false
        },
        "styleToolbarStateValidated": {
          "const": true
        },
        "productFrameValidated": {
          "const": true
        },
        "pageOnlyCrop": {
          "const": false
        }
      }
    },
    "screenshotRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "publicationStatus",
        "source",
        "assertions",
        "outputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "publicationStatus": {
          "const": "publication-approved"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw",
            "proof",
            "report",
            "fingerprint"
          ],
          "properties": {
            "raw": {
              "$ref": "#/$defs/pngBinding"
            },
            "proof": {
              "$ref": "#/$defs/fileBinding"
            },
            "report": {
              "$ref": "#/$defs/fileBinding"
            },
            "fingerprint": {
              "$ref": "#/$defs/fingerprint"
            }
          }
        },
        "assertions": {
          "$ref": "#/$defs/assertions"
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/outputBinding"
          }
        }
      }
    },
    "ogComposite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "publicationStatus",
        "output",
        "template",
        "dependencies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "publicationStatus": {
          "const": "publication-approved"
        },
        "output": {
          "$ref": "#/$defs/pngBinding"
        },
        "template": {
          "$ref": "#/$defs/fileBinding"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileBinding"
          }
        }
      }
    }
  }
}
